{
  "name": "skeleton",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate-api-client": "openapi-generator-cli generate -i src/api/specs/*.yaml -g typescript-axios -o src/api-client",
    "dev": "vite --port 5001 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "axios": "^1.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.3.1"
  }
}
